# ── 限流 ──
# 调大模型的接口(问答 / 批改 / 总结)每个 IP 每分钟 5 次。和后端的每日额度(application.yml 的 app.quota)分工:
# 这里防短时间狂刷,后端给每天的花费封顶。
# rate=5r/m 的意思是"平均 12 秒放行 1 次",只写它的话连发两问第二问就会被拒;
# 下面配上 burst=4 nodelay,才是"可以先连发 5 次,之后每 12 秒恢复 1 次"。
# key 是用户的真实 IP,由下面的「还原真实 IP」得到
limit_req_zone $binary_remote_addr zone=llm:10m rate=5r/m;
# 发注册验证码:每个 IP 先连发 3 次,之后每分钟 1 次。后端已有"同一邮箱 60 秒冷却",这里防换着邮箱刷
limit_req_zone $binary_remote_addr zone=code:10m rate=1r/m;

# ── 还原真实 IP ──
# 线上链路是 用户 → Cloudflare → 宿主机反代(1Panel openresty)→ 本容器,这里直接看到的全是 docker 网关
# (172.27.0.1),不还原的话所有人共用上面的限流额度。
# 做法:信任内网网段和 Cloudflare 的 IP 段,从 X-Forwarded-For 最右边往左跳过这些可信代理,第一个不可信的就是真实 IP。
# 有人绕过 Cloudflare 直连源站也伪造不了:宿主机反代会把连上来的真实 IP 追加在最右边,左边写什么都会被跳过。
# 前面没有代理、直接对外时,连上来的 IP 不在可信范围内,这段不起作用
set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;    # docker 网络,宿主机反代从网关进来
set_real_ip_from 192.168.0.0/16;
# Cloudflare 的 IP 段,来自 https://www.cloudflare.com/ips-v4 和 ips-v6(很少变,变了照着更新)
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 用 Docker 内置 DNS 按请求解析后端,而不是 nginx 启动时解析一次就缓存:
    # 只重建 server 容器(拉了新镜像)时它的 IP 会变,写死的 proxy_pass 会一直 502 到 web 也重启
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend "http://${BACKEND_ADDR}";

    # 反代参数写在 server 级,下面几个 /api 的 location 都继承,各自只写 proxy_pass。
    # 注意 proxy_set_header 的继承规则:某个 location 里只要自己写了一条,这里的就全部不继承了
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 问答是 SSE 流式:不关缓冲的话 nginx 攒满一块才往下吐,前端看不到逐字输出
    proxy_buffering off;
    proxy_cache off;
    # 批改是非流式 LLM 调用(后端超时 120s),默认 60s 会先断
    proxy_read_timeout 300s;

    # 被限流时回 JSON,和后端的错误格式一样({"error": ...}),前端直接把这句显示出来。
    # 只接管 nginx 自己发出的 429;后端的 429(每日额度用完)原样透传,提示语不会被盖掉
    limit_req_status 429;
    error_page 429 = @limited;
    location @limited {
        default_type application/json;
        return 429 '{"error":"请求太频繁,请稍后再试"}';
    }

    # 管理接口(重灌索引 / 构建评测集)没有鉴权,且会烧 LLM 额度,不对公网开放;
    # 需要时在宿主机上直接打后端:curl -X POST http://127.0.0.1:8080/api/admin/reindex
    # ^~:匹配上就不再看下面的正则 location,保证这条总是生效
    location ^~ /api/admin/ {
        return 403;
    }

    # 调大模型的接口:/api/chat/ask、/api/quiz/grade|report、/api/quiz/session/{id}/grade|report
    location ~ ^/api/(chat/ask|quiz/(session/[^/]+/)?(grade|report))$ {
        limit_req zone=llm burst=4 nodelay;
        proxy_pass $backend;
    }

    location = /api/auth/code {
        limit_req zone=code burst=2 nodelay;
        proxy_pass $backend;
    }

    location /api/ {
        proxy_pass $backend;
    }

    # Vite 产物文件名带内容哈希,可以长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # history 路由(/chat、/kb ...)刷新时回落到 index.html;index.html 本身不缓存,发版后立刻生效
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
