# 复制成 .env 再填(不进 git)。本地 compose 会自动读同目录 .env。
# 不填也能跑:provider=auto 且没 key 时自动走 mock(链路通,回答是占位)。

# ── PostgreSQL(pgvector)──
BAGUWEN_DB_URL=jdbc:postgresql://localhost:15432/baguwen_rag
BAGUWEN_DB_USER=baguwen
BAGUWEN_DB_PASSWORD=baguwen_pg_2026

# ── 生成端(问答/批改):随便换,不影响向量 ──
BAGUWEN_CHAT_PROVIDER=auto
BAGUWEN_CHAT_API_KEY=
BAGUWEN_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAGUWEN_CHAT_MODEL=qwen-plus

# ── 向量端(检索):换 model/dims 后**必须重新索引**(POST /api/admin/reindex)──
BAGUWEN_EMBED_PROVIDER=auto
BAGUWEN_EMBED_API_KEY=
BAGUWEN_EMBED_BASE_URL=https://api.siliconflow.cn/v1
BAGUWEN_EMBED_MODEL=BAAI/bge-m3
BAGUWEN_EMBED_DIMS=1024
# 是否显式传 dimensions:硅基流动 bge-m3 传了会报 400,所以默认 false;
# 用百炼 text-embedding-v3/v4 且要指定非默认维度时改成 true
BAGUWEN_EMBED_SEND_DIMENSIONS=false

# ── 重排端(cross-encoder,给多粒度候选统一打分)──
# 不填 KEY 时会自动复用 BAGUWEN_EMBED_API_KEY,但 **base-url 是各自独立的**:
# 若向量端指向百炼、这里用默认的硅基流动地址,key 会打错家 → 401 → 静默降级回召回原序。
# 显式写出来,把隐式耦合变成明确声明。bge-reranker-v2-m3 在硅基流动免费。
BAGUWEN_RERANK_PROVIDER=auto
BAGUWEN_RERANK_API_KEY=
BAGUWEN_RERANK_BASE_URL=https://api.siliconflow.cn/v1
BAGUWEN_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── 检索漏斗的三个 K(从宽到窄,一般不用改)──
# vector-k(10) 每路向量召回条数 → candidate-k(20,在 application.yml 里) 送进重排的候选
#   → top-n(5) 重排后最终进 prompt 的材料数
# 必须 top-n < candidate-k,否则重排只是给固定几条换顺序,捞不回排名靠后的正确答案。
BAGUWEN_RETRIEVAL_VECTOR_K=10
BAGUWEN_RETRIEVAL_TOP_N=5

# ── 语料路径(相对 server/ 工作目录)──
BAGUWEN_CORPUS_DIR=../corpus

# ── 账号 ──
# JWT 签名密钥,生成:openssl rand -base64 32。留空 = 每次启动随机生成(重启后所有登录失效,仅开发用)
BAGUWEN_JWT_SECRET=
BAGUWEN_TOKEN_TTL_HOURS=168

# ── chat 代理(可选)── base-url 指向需代理的端点时配置(如 Google Gemini 官方 API 经本机代理)。
# 只作用于 chat;embed/rerank 走国内端点保持直连。host 留空 = 直连,不受影响
# BAGUWEN_CHAT_PROXY_HOST=127.0.0.1
# BAGUWEN_CHAT_PROXY_PORT=7890

# ── 发信(验证码)── 默认走 Resend 的 SMTP(smtp.resend.com:465,用户名 resend)
# 不填 SMTP_PASSWORD 时 auto 走 mock,验证码打印在 logs/server.log(搜 [mock mail])
BAGUWEN_MAIL_PROVIDER=auto
# 只写地址,必须属于在 Resend 验证过的域名。显示名在 application.yml 的 app.mail.from-name(这里写中文会乱码)
BAGUWEN_MAIL_FROM=noreply@your-domain.com
# Resend 后台 → API Keys 新建,权限选 Sending access 并限定域名
BAGUWEN_SMTP_PASSWORD=
